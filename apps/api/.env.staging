# Devacia Staging Backend Configuration
# Safe sandbox environment: uses mock discovery to avoid credit burning,
# and points to local staging database.

ENVIRONMENT=staging
DISCOVERY_MODE=mock
DATABASE_URL=postgresql+psycopg://devacia:devacia_password@localhost:5432/devacia_os
REDIS_URL=redis://localhost:6379/0
JWT_SECRET_KEY=staging-devacia-super-secret-key-32chars-minimum-safe
FRONTEND_ORIGIN=http://localhost:3001

# Sandbox / Mock provider defaults
SERPER_API_KEY=mock_serper_key
GROQ_API_KEY=mock_groq_key
SNOVIO_CLIENT_ID=mock_snovio_client
SNOVIO_CLIENT_SECRET=mock_snovio_secret
PROXYCURL_API_KEY=mock_proxycurl_key
