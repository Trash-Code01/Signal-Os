# ==============================================================================
# DEVACIA LEAD INTELLIGENCE OS - LOCAL ENVIRONMENT CONFIGURATION
# ==============================================================================

# 1. Database & Message Queue
DATABASE_URL=postgresql://devacia:devacia_password@127.0.0.1:5432/devacia_os
REDIS_URL=redis://127.0.0.1:6379/0

# 2. AI & Reasoning
GEMINI_API_KEY=your_gemini_api_key_here
GEMINI_MODEL=gemini-3.6-flash

# 3. Discovery (Google Maps/SERP)
DATAFORSEO_USERNAME=your_dataforseo_email
DATAFORSEO_PASSWORD=your_dataforseo_password

# 4. Enrichment (Email & Decision Makers)
HUNTER_API_KEY=your_hunter_io_api_key
APOLLO_API_KEY=your_apollo_io_api_key
APOLLO_API_KEY_1=your_first_apollo_io_api_key
APOLLO_API_KEY_2=your_second_apollo_io_api_key
APOLLO_API_KEY_3=your_third_apollo_io_api_key
# Apollo search finds people; enrichment adds their work email, title, and
# LinkedIn. Personal email and mobile reveal consume Apollo credits. Phone
# reveal is asynchronous and requires a public HTTPS callback URL.
APOLLO_REVEAL_PERSONAL_EMAILS=false
APOLLO_REVEAL_PHONE=false
APOLLO_WEBHOOK_URL=https://your-public-api.example.com/api/webhooks/apollo
APOLLO_WEBHOOK_SECRET=replace_with_a_long_random_value

# 5. Auditing (Website Performance)
PAGESPEED_API_KEY=your_google_pagespeed_api_key

# 6. Web Search & Verification
BRAVE_SEARCH_API_KEY=your_brave_search_api_key
SERPER_API_KEY=your_serper_api_key

# 7. System Toggles
DISCOVERY_MODE=live # live, mock, or fixture. Mock is test-only.
